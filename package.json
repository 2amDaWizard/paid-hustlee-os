    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^31.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
